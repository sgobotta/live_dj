<div
  id="keybindings"
  phx-hook="Keybindings"
  data-active={if @live_action == :show, do: "true", else: "false"}
  class="hidden"
/>

<%= if @content_ready do %>
  <div class="border-t-[1px] border-zinc-200 dark:border-zinc-800 mb-4">
    {live_render(
      @socket,
      LivedjWeb.Sessions.RoomLive.List,
      id: @list_lv_id,
      session: %{"id" => @room.id},
      sticky: true
    )}
  </div>
<% end %>
