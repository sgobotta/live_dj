<%= if connected?(@socket) do %>
  <.header class="text-zinc-900 dark:text-zinc-100">
    <%= gettext("Playing now...") %>
  </.header>

  <div class="w-full overflow-x-scroll" id="salsa">
    <.room_grid
      :let={%{id: _room_id, room: room, player: player, users: users}}
      id="room-grid"
      modules={@rooms_players}
      module_click={
        fn %{room: room} -> JS.navigate(~p"/sessions/rooms/#{room}") end
      }
    >
      <div class="flex flex-col">
        <.live_component
          id={"player-preview-#{room.id}"}
          player={player}
          module={LivedjWeb.PlayerPreview}
          rooms_players={@rooms_players}
        />
        <div class="
          h-12 w-40 px-2 font-semibold
          text-zinc-900 dark:text-zinc-100
        ">
          <p class="font-normal text-xs truncate h-5">
            <%= room.name %>
          </p>
          <.mini_avatar_stack users={users} />
        </div>
      </div>
    </.room_grid>
  </div>

  <.link patch={~p"/sessions/rooms/new"} tabindex="-1">
    <.button class="
      fixed bottom-6 right-6
      flex items-center gap-2
      rounded-full shadow-lg
      px-5 py-3
    ">
      <.icon name="hero-plus" class="h-5 w-5" />
      <%= gettext("New Room") %>
    </.button>
  </.link>

  <.modal
    :if={@live_action in [:new]}
    id="room-modal"
    show
    on_cancel={JS.patch(~p"/sessions/rooms")}
  >
    <.live_component
      module={LivedjWeb.Sessions.RoomLive.FormComponent}
      id={@room.id || :new}
      title={@page_title}
      action={@live_action}
      room={@room}
      patch={~p"/sessions/rooms"}
    />
  </.modal>
<% end %>
