<div
  id="lists"
  class="
    grid sm:grid-cols-1 overflow-y-scroll h-32 sm:h-52 md:h-44 p-0
  "
>
  <.live_component
    id={"playlist_#{@room.id}"}
    current_media={@current_media}
    module={LivedjWeb.ListComponent}
    list={@media_list}
    on_drag_start={on_drag_start(@room.id)}
    on_drag_end={on_drag_end(@room.id)}
    state={@drag_state}
    topic={"room:#{@room.id}"}
  />
</div>
