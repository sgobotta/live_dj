<.welcome_modal
  room={assigns[:room]}
  room_url={assigns[:room_url]}
  show={assigns[:live_action] == :welcome}
/>

<.browse_modal
  room={assigns[:room]}
  show={assigns[:live_action] == :browse}
  user_id={to_string(@current_user.id)}
  display_name={assigns[:display_name]}
/>

<.help_modal
  room={assigns[:room]}
  show={assigns[:live_action] == :help}
/>

<.settings_modal
  room={assigns[:room]}
  show={
    assigns[:live_action] in [
      :settings_general,
      :settings_room,
      :settings_appearance
    ]
  }
  tab={
    case assigns[:live_action] do
      :settings_room -> :room
      :settings_appearance -> :appearance
      _ -> :general
    end
  }
  theme={@theme}
  current_user={@current_user}
/>

<div class="flex flex-col h-dvh">
  <header class="px-4 sm:px-6 lg:px-8 static top-0 w-full">
    <div class="grid grid-cols-3 items-center  py-3 text-sm">
      <div class="flex items-center justify-start">
        <.theme_hook_anchor />
      </div>
      <div class="flex justify-center">
        <a
          href="/sessions/rooms"
          data-confirm={gettext("Exit session?")}
          class="rounded focus:outline-none focus-ignite"
        >
          <.livedj_logo theme={@theme} />
        </a>
      </div>
      <div class="flex items-center justify-end gap-4">
        <%= if assigns[:room] do %>
          <div class="relative group [@media(hover:none)]:hidden">
            <button
              id="help-btn"
              phx-click="open_help_modal"
              class="text-tone-700 dark:text-tone-300 hover:text-tone-900 dark:hover:text-tone-50 transition-colors duration-150 cursor-pointer rounded focus:outline-none focus-ignite"
            >
              <.icon name="hero-question-mark-circle" class="h-5 w-5" />
            </button>
            <.tooltip position={:below} class="left-1/2 -translate-x-1/2 z-30">
              {gettext("Help")} (H)
            </.tooltip>
          </div>
          <div class="relative group">
            <button
              id="chat-btn"
              phx-click="toggle_chat"
              class="text-tone-700 dark:text-tone-300 hover:text-tone-900 dark:hover:text-tone-50 transition-colors duration-150 cursor-pointer rounded focus:outline-none focus-ignite"
            >
              <.icon name="hero-chat-bubble-left-ellipsis" class="h-5 w-5" />
            </button>
            <.tooltip position={:below} class="left-1/2 -translate-x-1/2 z-30">
              {gettext("Chat")} (C)
            </.tooltip>
          </div>
          <div class="relative group">
            <button
              id="share-btn"
              phx-click="open_share_modal"
              class="text-tone-700 dark:text-tone-300 hover:text-tone-900 dark:hover:text-tone-50 transition-colors duration-150 cursor-pointer rounded focus:outline-none focus-ignite"
            >
              <.icon name="hero-share" class="h-5 w-5" />
            </button>
            <.tooltip position={:below} class="left-1/2 -translate-x-1/2 z-30">
              {gettext("Share")} (S)
            </.tooltip>
          </div>
          <div class="relative group">
            <button
              id="settings-btn"
              phx-click="open_settings_modal"
              class="text-tone-700 dark:text-tone-300 hover:text-tone-900 dark:hover:text-tone-50 transition-colors duration-150 cursor-pointer rounded focus:outline-none focus-ignite"
            >
              <.icon name="hero-cog-6-tooth" class="h-5 w-5" />
            </button>
            <.tooltip position={:below} class="left-1/2 -translate-x-[65%] z-30">
              {gettext("Settings")} (;)
            </.tooltip>
          </div>
          <.mini_avatar_stack
            id="session-header-avatars"
            users={assigns[:users] || []}
            size={:md}
            max_visible={3}
            current_user_id={@current_user.id}
          />
        <% end %>
      </div>
    </div>
    <%!-- <ul class="relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
    <%= if @current_user do %>
      <li class="text-[0.8125rem] leading-6">
        <.text><%= @current_user.username %></.text>
      </li>
      <li>
        <.link
          href={~p"/users/settings"}
          class="text-[0.8125rem] leading-6 text-tone-900 dark:text-tone-100 font-semibold hover:text-tone-700 dark:hover:text-tone-300"
        >
          <.text><%= gettext("Settings") %></.text>
        </.link>
      </li>
      <li>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="text-[0.8125rem] leading-6 text-tone-900 dark:text-tone-100 font-semibold hover:text-tone-700 dark:hover:text-tone-300"
        >
          <.text><%= gettext("Log out") %></.text>
        </.link>
      </li>
    <% else %>
      <li>
        <.link
          href={~p"/users/register"}
          class="text-[0.8125rem] leading-6 text-tone-900 dark:text-tone-100 font-semibold hover:text-tone-700 dark:hover:text-tone-300"
        >
          <.text><%= gettext("Register") %></.text>
        </.link>
      </li>
      <li>
        <.link
          href={~p"/users/log_in"}
          class="text-[0.8125rem] leading-6 text-tone-900 dark:text-tone-100 font-semibold hover:text-tone-700 dark:hover:text-tone-300"
        >
          <.text><%= gettext("Log in") %></.text>
        </.link>
      </li>
    <% end %>
  </ul> --%>
  </header>

  <main class="flex-1 flex flex-col overflow-hidden lg:px-8 bg-tone-200 dark:bg-tone-800 pt-2 gap-1">
    <div class="mx-1 sm:mx-auto sm:w-full max-w-xl">
      <.flash_group flash={@flash} />
      <div id="player-slot" class="h-72 w-full shrink-0"></div>
    </div>
    <div class="flex-1 overflow-y-auto">
      <div class="mx-1 sm:mx-auto max-w-xl">
        {@inner_content}
      </div>
    </div>
  </main>

  <footer class="shrink-0 w-full">
    {live_render(
      @socket,
      LivedjWeb.PlayerControlsLive,
      id: "player-controls",
      session: %{
        "id" => assigns[:room].id,
        "user_id" => to_string(@current_user.id),
        "display_name" => assigns[:display_name]
      },
      sticky: true
    )}
  </footer>
</div>
